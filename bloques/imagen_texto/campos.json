{
  "label": "Imagen y texto",
  "name": "imagen_texto",
  "widget": "object",
  "summary": "Imagen y texto — {{fields.titulo}}",
  "fields": [
    {
      "label": "Foto",
      "name": "imagen",
      "widget": "image",
      "required": false,
      "hint": "Media pantalla a sangre."
    },
    {
      "label": "Qué se ve en la foto",
      "name": "descripcion",
      "widget": "string",
      "default": "",
      "required": false,
      "hint": "Para personas que no ven la imagen y para Google. Puede ir vacío si es decorativa."
    },
    {
      "label": "Imagen a la derecha",
      "name": "imagen_derecha",
      "widget": "boolean",
      "default": false
    },
    {
      "label": "Rótulo",
      "name": "rotulo",
      "widget": "string",
      "default": "Cómo empezamos"
    },
    {
      "label": "Título",
      "name": "titulo",
      "widget": "string",
      "default": "Un título para la historia"
    },
    {
      "label": "Texto",
      "name": "texto",
      "widget": "text",
      "default": "Un párrafo que cuente algo concreto del lugar."
    },
    {
      "label": "Ancla para el menú",
      "name": "ancla",
      "widget": "string",
      "default": "",
      "required": false,
      "hint": "Sin espacios (p. ej. equipo): el menú la enlaza como #equipo. Vacío = sin ancla.",
      "pattern": [
        "^[a-z0-9-]*$",
        "Sólo minúsculas, números y guiones"
      ]
    }
  ]
}